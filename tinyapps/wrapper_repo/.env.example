# Document Review settings. Copy to `.env` for LOCAL runs (the test machine,
# a laptop). Ask the App Services engineers for the values: they are the
# same ones that live in the app's Key Vault. Never commit the real .env.
#
# On the App Service nothing here is used: values come from Key Vault (app
# setting KV_NAME) and the app settings instead.

# ---- Prompter (the AI model endpoint) ----
# the full chat-completions URL the engineers give; the app derives the base
PROMPTER_URL=
# the model deployment's name (the pilot key serves one model)
PROMPTER_MODEL=
PROMPTER_API_KEY=
# the internal CA certificate: a path to the .pem, or the PEM text itself
PROMPTER_CA_BUNDLE=
# Locally (one person, DEV_IDENTITY) the shared key above is the one used.
# On the published app each signed-in tester uses their OWN key, from Key
# Vault: PROMPTER-API-KEY--<TESTER> (e.g. PROMPTER-API-KEY--CORP-JDOE) or the
# PROMPTER-KEYS JSON secret. To let testers without one share the key above:
# PROMPTER_SHARED_KEY_FALLBACK=1

# ---- SharePoint (the conversation mirror), via an app registration ----
# Every conversation is copied to the site after each turn, under
# <GEOTECH_SHAREPOINT_ROOT>/conversations/<tester>/document_review/ (one
# person locally: <root>/conversations/document_review/). Leave all four empty to run
# without the mirror.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
# Optional (docs/SHAREPOINT_SETUP.md in the source repository). Test the
# connection with: python -m aec_document_review.graph_sharepoint --check
# A certificate instead of the secret, with its private key: PEM (path or
# text), or PKCS #12 (a .pfx/.p12 path, or the base64 text Key Vault keeps);
# the password, if any, goes in GRAPH_CLIENT_KEY_PASSWORD:
# GRAPH_CLIENT_CERT=
# GRAPH_CLIENT_KEY=
# GRAPH_CLIENT_KEY_PASSWORD=
# GRAPH_CLIENT_CERT_THUMBPRINT=
# The Microsoft cloud: commercial, gcc_high or dod (when not set, taken from
# the site address: .sharepoint.com, .sharepoint.us, .sharepoint-mil.us); or
# both URLs:
# GRAPH_CLOUD=commercial
# GRAPH_LOGIN_URL=
# GRAPH_API_URL=
# More sites, comma-separated here (Key Vault may hold one per line), each
# name=URL or URL; a path on one starts "name:" (the first site is the default):
# SHAREPOINT_SITE_URLS=
# base folder inside the site (default: Shared Documents/GeotechStaffEngineer)
GEOTECH_SHAREPOINT_ROOT=
# SharePoint errors are kept in <root>/_app_log/sharepoint-YYYY-MM.log; 0 = off:
# GEOTECH_SHAREPOINT_LOG=1

# ---- Local development only ----
# There is no IIS locally, so no identity header arrives; stand in as someone.
DEV_IDENTITY=CORP\jdoe
# Uncomment if the gateway refuses streaming responses.
# GEOTECH_PROMPTER_DISABLE_STREAMING=1

# ---- Where conversations live on this machine (optional) ----
# app.py sets /home/data/geotech_webapp on the App Service; elsewhere the
# default is ~/.geotech_webapp.
# GEOTECH_WEBAPP_DATA=

# ---- This deployment's own instructions for the agents (optional) ----
# The full path of a folder holding all.md (every agent and helper) and
# main.md, general-purpose.md, figure.md (one role each). On the App Service
# it is an app setting, not a Key Vault secret. Unset = no instructions added.
# GEOTECH_INSTRUCTIONS=

# ---- Long turns and rate limits (optional; the defaults suit most runs) ----
# (environment or app settings, not Key Vault)
# Pace calls to stay under the deployment's tokens-per-minute limit; set a
# little under the real limit once CfA gives it. Unset = no pacing.
# GEOTECH_TOKENS_PER_MINUTE=
# Helpers (`task`) that may run at once per conversation (0 = no cap).
# GEOTECH_MAX_HELPERS=2
# Model calls a general-purpose helper may make; its last call hands over
# what it gathered (0 = no budget).
# GEOTECH_HELPER_MAX_MODEL_CALLS=30
# Tries for a model call refused as busy (429 / overloaded), and the most
# seconds a turn may spend waiting on such refusals in all.
# GEOTECH_AGENT_BUSY_TRIES=5
# GEOTECH_BUSY_TURN_MAX_S=900
# Token use is requested on streamed replies; set 0 if the gateway refuses it.
# GEOTECH_PROMPTER_STREAM_USAGE=1

# ---- Agent behaviours on by default (set 0 to turn one off) ----
# The figure helper draws figures and checks them; plotting code lets it
# draw in matplotlib or Plotly code run in a locked box. Plotting code
# brings the helper with it, so set both to 0 to leave the helper out.
# GEOTECH_FIGURE_HELPER=0
# GEOTECH_PLOT_CODE=0
