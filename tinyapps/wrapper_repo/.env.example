# Document Review settings. Copy to `.env` for LOCAL runs (the test machine,
# a laptop). Ask the App Services engineers for the values: they are the
# same ones that live in the app's Key Vault. Never commit the real .env.
#
# On the App Service nothing here is used: values come from Key Vault (app
# setting KV_NAME) and the app settings instead.

# ---- Prompter (the AI model endpoint) ----
# the full chat-completions URL the engineers give; the app derives the base
PROMPTER_URL=
# the model deployment's name (the pilot key serves one model)
PROMPTER_MODEL=
PROMPTER_API_KEY=
# the internal CA certificate: a path to the .pem, or the PEM text itself
PROMPTER_CA_BUNDLE=
# Locally (one person, DEV_IDENTITY) the shared key above is the one used.
# On the published app each signed-in tester uses their OWN key, from Key
# Vault: PROMPTER-API-KEY--<TESTER> (e.g. PROMPTER-API-KEY--CORP-JDOE) or the
# PROMPTER-KEYS JSON secret. To let testers without one share the key above:
# PROMPTER_SHARED_KEY_FALLBACK=1

# ---- SharePoint (the conversation mirror), via an app registration ----
# Every conversation is copied to the site after each turn, under
# <GEOTECH_SHAREPOINT_ROOT>/conversations/<tester>/document_review/ (one
# person locally: <root>/conversations/document_review/). Leave all four empty to run
# without the mirror.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
# Optional (docs/SHAREPOINT_SETUP.md in the source repository). Test the
# connection with: python -m aec_document_review.graph_sharepoint --check
# A certificate instead of the secret, with its private key: PEM (path or
# text), or PKCS #12 (a .pfx/.p12 path, or the base64 text Key Vault keeps);
# the password, if any, goes in GRAPH_CLIENT_KEY_PASSWORD:
# GRAPH_CLIENT_CERT=
# GRAPH_CLIENT_KEY=
# GRAPH_CLIENT_KEY_PASSWORD=
# GRAPH_CLIENT_CERT_THUMBPRINT=
# The Microsoft cloud: commercial, gcc_high or dod (when not set, taken from
# the site address: .sharepoint.com, .sharepoint.us, .sharepoint-mil.us); or
# both URLs:
# GRAPH_CLOUD=commercial
# GRAPH_LOGIN_URL=
# GRAPH_API_URL=
# More sites, comma-separated here (Key Vault may hold one per line), each
# name=URL or URL; a path on one starts "name:" (the first site is the default):
# SHAREPOINT_SITE_URLS=
# base folder inside the site (default: Shared Documents/GeotechStaffEngineer)
GEOTECH_SHAREPOINT_ROOT=
# SharePoint errors are kept in <root>/_app_log/sharepoint-YYYY-MM.log; 0 = off:
# GEOTECH_SHAREPOINT_LOG=1
# The largest file sent to SharePoint, in MB (default 2048); a larger one
# is not sent, and the save names it:
# GEOTECH_SHAREPOINT_MAX_UPLOAD_MB=2048

# ---- Local development only ----
# There is no IIS locally, so no identity header arrives; stand in as someone.
DEV_IDENTITY=CORP\jdoe
# Uncomment if the gateway refuses streaming responses.
# GEOTECH_PROMPTER_DISABLE_STREAMING=1

# ---- Where conversations live on this machine (optional) ----
# app.py sets /home/data/geotech_webapp on the App Service; elsewhere the
# default is ~/.geotech_webapp.
# GEOTECH_WEBAPP_DATA=

# ---- This deployment's own instructions for the agents (optional) ----
# The full path of a folder holding all.md (every agent and helper) and
# main.md, general-purpose.md, figure.md (one role each). On the App Service
# it is an app setting, not a Key Vault secret. Unset = no instructions added.
# GEOTECH_INSTRUCTIONS=

# ---- Long turns and rate limits (optional; the defaults suit most runs) ----
# (environment or app settings, not Key Vault)
# Pace calls to stay under the deployment's tokens-per-minute limit; set a
# little under the real limit once CfA gives it. Unset = no pacing.
# GEOTECH_TOKENS_PER_MINUTE=
# Helpers (`task`) that may run at once per conversation (0 = no cap).
# GEOTECH_MAX_HELPERS=2
# Model calls a general-purpose helper may make; its last call hands over
# what it gathered (0 = no budget).
# GEOTECH_HELPER_MAX_MODEL_CALLS=30
# Tries for a model call refused as busy (429 / overloaded), and the most
# seconds a turn may spend waiting on such refusals in all.
# GEOTECH_AGENT_BUSY_TRIES=5
# GEOTECH_BUSY_TURN_MAX_S=900
# Image calls one turn may make (each image sent to the model for a
# reading; a page read in tiles is up to 17), all its helpers together.
# Past it a look is refused and the turn finishes with what it read
# (0 or unset = no ceiling). The count is kept in the turn's record
# either way.
# GEOTECH_TURN_MAX_IMAGE_CALLS=0
# Token use is requested on streamed replies; set 0 if the gateway refuses it.
# GEOTECH_PROMPTER_STREAM_USAGE=1
# The model client asks a request again once, at once (a timeout, a
# dropped connection, a brief rate limit); 0 = not at all.
# GEOTECH_PROMPTER_MAX_RETRIES=1
# Seconds before a page reading (a vision call) is given up and asked
# once more.
# GEOTECH_VISION_CALL_TIMEOUT_S=90
# Seconds a look waits for a free reading slot before it comes back as
# not read (0 = no bound).
# GEOTECH_VISION_SLOT_WAIT_S=600

# ---- Agent behaviours on by default (set 0 to turn one off) ----
# The figure helper draws figures and checks them; plotting code lets it
# draw in matplotlib or Plotly code run in a locked box. Plotting code
# brings the helper with it, so set both to 0 to leave the helper out.
# GEOTECH_FIGURE_HELPER=0
# GEOTECH_PLOT_CODE=0

# ---- Page features off by default (1 turns one on; the owner's call) ----
# A Stop button while a tester's own turn runs; what the turn did is kept.
# GEOTECH_STOP_BUTTON=1
# An estimate of each tester's own AI spend this month in the sidebar,
# from their own conversations' token counts, priced in US dollars per
# million tokens (without the prices it counts tokens only); the budget
# is optional.
# GEOTECH_SPEND_ESTIMATE=1
# GEOTECH_SPEND_INPUT_USD_PER_MTOK=
# GEOTECH_SPEND_OUTPUT_USD_PER_MTOK=
# GEOTECH_SPEND_MONTHLY_BUDGET_USD=
# planlens' sheet tools: the sheet index, the callout check and the
# schedule-mark check; with a planlens after 0.16.0 the page's document
# tools also take a printed sheet number (sheets / sheet) wherever they
# take a page (not measured on a model yet).
# GEOTECH_REVIEW_SHEET_TOOLS=1
# Asks the agent to update its to-do list in the same step as its next
# tool call (not measured yet).
# GEOTECH_REVIEW_TODOS_WITH_CALLS=1
# Lets the agent have a page or region shown to its own model instead of a
# separate reading's description (not measured yet).
# GEOTECH_VISION_SHOW_ME=1
# A page of photographs takes one look instead of a whole-page look and
# tiles, only where the page itself shows it is one; any doubt tiles the
# page as before (not measured yet).
# GEOTECH_VISION_PHOTO_PAGE_ONE_LOOK=1
# Each tile of a tiled read answers the request from what it holds, with
# one line where it holds nothing on it (not measured yet).
# GEOTECH_VISION_TILE_ANSWERS=1
# The attached documents' photograph pages that nothing looked at:
# "record" keeps them in the turn's record; "retry" also tells the agent
# once before its answer goes out. It reads every page of each attached
# PDF once, at the first turn end after it is attached (not measured yet).
# GEOTECH_PHOTO_PAGES=record
# planlens' plan tools on the page and its reading helper: every small
# symbol on a vector plan sheet with its centre and label, and page points
# turned into local easting / northing (not measured yet).
# GEOTECH_REVIEW_PLAN_TOOLS=1
# The figure helper works from this page's own worked examples (a plan to
# scale, a schedule against a count, comments by sheet) in place of the
# geotechnical ones (not measured yet).
# GEOTECH_REVIEW_FIGURE_EXAMPLES=1
# Takes the agent library's generic prompt texts off the page's build and
# puts the page's short ones in their place; where a text is not found
# word for word the prompt goes out as it was and the turn's record says
# so (not measured yet).
# GEOTECH_REVIEW_LEAN_PROMPT=1
# An image file a tester uploads is shown to the page's main model itself
# instead of being read for it by a vision call. Set it ONLY where the
# main model takes images: a text-only model's turn fails at its first
# call after a look (not measured yet).
# GEOTECH_VISION_SHOW_UPLOADS=1
# A request to a page look for positions in the page's own units is asked
# of the vision model as pixel boxes, which the tool converts to page
# points itself (not measured yet).
# GEOTECH_VISION_PIXEL_REQUESTS=1
# planlens' drawing tool on the page and its reading helper: one page's
# dimensions and leaders read from its drawn lines, for a CAD sheet whose
# lettering is drawn in strokes. Needs a planlens after 0.16.0 (not
# measured yet).
# GEOTECH_REVIEW_DRAWING_TOOLS=1
# An uploaded DXF is also opened as a one-page plot, so the page can look
# at it. Needs a planlens after 0.16.0 with ezdxf and Pillow in the
# environment; without them the page is as it was (not measured yet).
# GEOTECH_REVIEW_DXF_PLOTS=1
# Only where plotting code is on (GEOTECH_PLOT_CODE=1), on Linux: the
# process the plotting box runs code in also puts on what the host's
# kernel offers (no new privileges, Landlock file and TCP rules, a seccomp
# filter). 1: what is offered goes up and the result says which parts;
# require: where the file rules cannot go up the box runs no code. Unset
# or 0: the box as it was; any other value: the box runs no code (not
# checked on the App Service yet).
# GEOTECH_PLOT_CODE_KERNEL_LAYER=1
